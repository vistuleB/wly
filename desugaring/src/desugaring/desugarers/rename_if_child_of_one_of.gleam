import desugaring/authoring
import desugaring/core.{
  type Desugarer, type DesugarerTransform, type DesugaringError,
}
import desugaring/nodemaps_2_transform as n2t
import desugaring/testing
import gleam/list
import vxml.{type VXML, V}

pub const name = "rename_if_child_of_one_of"

// 🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️
// 🏖️🏖️ Desugarer 🏖️🏖️
// 🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️🏖️️️️️🏖️

/// Renames matching elements beneath any configured parent.
pub fn constructor(param: Param) -> Desugarer {
  authoring.desugarer(
    name: name,
    param: param,
    prepare: param_to_inner_param,
    transform: inner_param_to_transform,
  )
}

type Param =
  #(
    // Existing tag.
    String,
    // New tag.
    String,
    // Allowed parent tags.
    List(String),
  )

type InnerParam =
  #(String, String, List(String))

fn param_to_inner_param(param: Param) -> Result(InnerParam, DesugaringError) {
  Ok(param)
}

fn inner_param_to_transform(inner: InnerParam) -> DesugarerTransform {
  let nodemap: n2t.OneToOneNoErrorNodemap = nodemap(_, inner)
  nodemap
  |> n2t.one_to_one_no_error_nodemap_2_desugarer_transform()
}

fn nodemap(vxml: VXML, inner: InnerParam) -> VXML {
  case vxml {
    V(_, tag, _, children) ->
      case list.contains(inner.2, tag) {
        True -> {
          let children = list.map(children, rename_child_if_right_tag(_, inner))
          V(..vxml, children: children)
        }
        False -> vxml
      }
    _ -> vxml
  }
}

fn rename_child_if_right_tag(child: VXML, inner: InnerParam) -> VXML {
  case child {
    V(_, tag, _, _) if tag == inner.0 -> V(..child, tag: inner.1)
    _ -> child
  }
}

